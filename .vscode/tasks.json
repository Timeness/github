{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "GitView Dev",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--port",
				"3000"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "nuxt-dev",
				"pattern": {
					"regexp": "^(?!)$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Nuxt \\d+\\.",
					"endsPattern": "Nuxt dev server stopped"
				}
			}
		}
	]
}